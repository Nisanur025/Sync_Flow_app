<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/splashFragment">

    <fragment
        android:id="@+id/loginFragment"
        android:name="com.example.syncflow.LoginFragment"
        android:label="fragment_login"
        tools:layout="@layout/fragment_login" >
        <action
            android:id="@+id/action_loginFragment_to_registerFragment"
            app:destination="@id/registerFragment" />
    </fragment>
    <fragment
        android:id="@+id/registerFragment"
        android:name="com.example.syncflow.RegisterFragment"
        android:label="fragment_register"
        tools:layout="@layout/fragment_register" >
        <action
            android:id="@+id/action_registerFragment_to_registerStepTwoFragment"
            app:destination="@id/registerStepTwoFragment" />
        <action
            android:id="@+id/action_registerFragment_to_registerStepTwoFragment2"
            app:destination="@id/registerStepTwoFragment" />
        <action
            android:id="@+id/action_registerFragment_to_registerStepTwoFragment3"
            app:destination="@id/registerStepTwoFragment" />
    </fragment>
    <fragment
        android:id="@+id/registerStepTwoFragment"
        android:name="com.example.syncflow.RegisterStepTwoFragment"
        android:label="fragment_register_step_two"
        tools:layout="@layout/fragment_register_step_two" >
        <action
            android:id="@+id/action_registerStepTwoFragment_to_registerStepThreeFragment"
            app:destination="@id/registerStepThreeFragment" />
    </fragment>
    <fragment
        android:id="@+id/registerStepThreeFragment"
        android:name="com.example.syncflow.RegisterStepThreeFragment"
        android:label="fragment_register_step_three"
        tools:layout="@layout/fragment_register_step_three" />
    <fragment
        android:id="@+id/splashFragment"
        android:name="com.example.syncflow.SplashFragment"
        android:label="SplashFragment" >
        <action
            android:id="@+id/action_splashFragment_to_loginFragment"
            app:destination="@id/loginFragment" />
    </fragment>
</navigation>