<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.SyncFlow" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
    </style>

    <style name="Theme.SyncFlow" parent="Base.Theme.SyncFlow" />

    <!--Kök Stil-->
    <style name="SyncFlowUI" />

    <!--input için stil-->
    <style name="SyncFlowUI.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/white</item>
        <item name="boxStrokeColor">@color/input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="hintTextColor">@color/primary</item>
        <item name="android:textColorHint">@color/olive</item>
        <item name="boxCornerRadiusTopStart">16dp</item>
        <item name="boxCornerRadiusTopEnd">16dp</item>
        <item name="boxCornerRadiusBottomStart">16dp</item>
        <item name="boxCornerRadiusBottomEnd">16dp</item>
    </style>

    <!--Ortak Label için stil gold renk-->
    <style name="SyncFlowUI.Label">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">24dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/gold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!--TextButton-->
    <style name="SyncFlowUI.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/primary</item>
    </style>

    <!-- Tüm ana butonların ortak görünümü -->
    <style name="Button.Primary" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/primary</item>
        <item name="cornerRadius">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:padding">15dp</item>
        <item name="iconPadding">8dp</item>
    </style>

    <!-- Sağında ikon olan "İleri" butonu -->
    <style name="Button.Primary.Next">
        <item name="icon">@drawable/ic_right_chevron</item>
        <item name="iconGravity">textEnd</item>
        <item name="iconTint">@color/beige</item>
    </style>

    <!-- Solunda ikon olan "Geri" butonu -->
    <style name="Button.Primary.Back">
        <item name="icon">@drawable/ic_left_chevron</item>
        <item name="iconGravity">textStart</item>
        <item name="iconTint">@color/beige</item>
    </style>

    <style name="StepIndicator" />
    <!-- Çizgilerin bulunduğu kap -->
    <style name="StepIndicator.Container">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginTop">100dp</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>

    <!-- Ortak özellikler: yükseklik ve aralık -->
    <style name="StepIndicator.Bar">
        <item name="android:layout_height">10dp</item>
        <item name="android:layout_marginEnd">6dp</item>
    </style>

    <!-- Aktif adım -->
    <style name="StepIndicator.Bar.Active">
        <item name="android:layout_width">40dp</item>
        <item name="android:background">@drawable/step_active</item>
    </style>

    <!-- Pasif adım -->
    <style name="StepIndicator.Bar.Inactive">
        <item name="android:layout_width">25dp</item>
        <item name="android:background">@drawable/step_inactive</item>
    </style>
    
    <!--Delete Buton-->
    <style name="SyncFlowUI.Button.Delete" parent="Widget.Material3.Button.IconButton.Filled">
        <item name="backgroundTint">@color/transparent</item>
        <item name="icon">@drawable/ic_close_fill</item>
        <item name="cornerRadius">12dp</item>
        <item name="iconTint">@color/red</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:padding">10dp</item>
    </style>

    <!--Kesikli Buton-->
    <style name="SyncFlowUI.Button.DashedAdd" parent="">
        <item name="android:background">@drawable/dashed_btn</item>
        <item name="android:textColor">@color/dark_green</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:padding">15dp</item>
        <item name="android:drawableStart">@drawable/ic_plus</item>
        <item name="android:drawablePadding">22dp</item>
        <item name="android:drawableTint">@color/dark_green</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>


    <style name="SyncFlowUI.Splash.Text" parent="">
        <item name="android:textSize">36sp</item>
        <item name="fontFamily">Serif</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
    </style>

</resources>